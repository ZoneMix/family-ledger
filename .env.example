# The Family Ledger — environment config.
# Copy this file to `.env` and fill in the values below.
# `.env` is gitignored — never commit your real values.
#
# You normally don't need to edit this by hand: ./setup.sh writes it
# for you (including ACTUAL_PASSWORD and ACTUAL_SYNC_ID, which it
# discovers interactively). This file is here for reference and for
# anyone who prefers to configure things manually.

# Actual Budget server password and the sync ID of the budget file you
# want the dashboard to read (required). Find the sync ID in Actual
# under: gear icon -> Settings -> Show advanced settings -> Sync ID.
ACTUAL_PASSWORD=
ACTUAL_SYNC_ID=

# Title shown in the dashboard header and browser tab.
APP_TITLE="The Family Ledger"

# Timezone used for "today" / month-boundary calculations. Use an IANA
# name, e.g. America/Chicago, America/New_York, Europe/London.
TZ=America/Chicago

# Ports exposed on the HOST machine. Change these if 3100 or 5006 are
# already used by something else on your server.
DASHBOARD_PORT=3100
ACTUAL_PORT=5006

# Currency symbol/code and locale used to format numbers and dates.
CURRENCY=USD
LOCALE=en-US

# How often the dashboard re-reads cached budget data, in milliseconds.
# 300000 = 5 minutes. Lower values hit the Actual server more often.
REFRESH_INTERVAL_MS=300000

# How often the dashboard asks Actual to sync with the server, in
# milliseconds. 7200000 = 2 hours.
AUTO_SYNC_INTERVAL_MS=7200000

# Optional password gate for the dashboard itself. Leave empty for no
# login — fine for a trusted home network where Actual's own password
# is already the real gate. Set this if the dashboard is reachable by
# anyone besides your household (e.g. exposed beyond your LAN).
DASHBOARD_PASSWORD=
